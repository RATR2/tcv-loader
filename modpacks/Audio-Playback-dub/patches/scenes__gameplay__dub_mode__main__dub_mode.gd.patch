 var resource: GameplayResourceDubMode


+# Hearing your own last take alongside the original when you press "Hear
+# clip again". Profile.dub_mode_hear_recording_on_replay (default on) and
+# .dub_mode_hear_recording_offset (default off; plays them back to back
+# instead of together) live in Options and Settings under Dub Mode, see
+# dub_options_settings_block.gd. This checkbox controls the exact same
+# Profile value rather than its own separate state, so either one flips
+# both, and _update_from_difficulty_toggles() (already re-run on every
+# Profile.changed_dub_mode_options, further down) keeps it in sync if the
+# Options screen changes it while this one is on screen.
+var chk_mic_playback: CheckBox
+
+
+func _setup_mic_playback_checkbox() -> void :
+	chk_mic_playback = CheckBox.new()
+	chk_mic_playback.text = "Mic Playback"
+	chk_mic_playback.tooltip_text = "When on, \"Hear clip again\" also plays your last take for this clip. See Options and Settings for together vs. back to back."
+	chk_mic_playback.button_pressed = Profile.dub_mode_hear_recording_on_replay
+	chk_mic_playback.toggled.connect(Profile._set_dub_mode_hear_recording_on_replay)
+	remote_buttons.add_child(chk_mic_playback)
+
+
+func _play_own_recording() -> void :
+	# member_audio on the current performance_array entry isn't filled in
+	# until _button_next() runs, so for the clip you're actively on it's
+	# still null. MicrophoneService.get_recording() is the same non-
+	# destructive call _button_next() itself uses to grab the just-finished
+	# take, so it's safe to call here too without disturbing that later read.
+	if not (MicrophoneService is Node): return
+	var recording: AudioStreamWAV = MicrophoneService.get_recording()
+	if recording == null or recording.data.is_empty(): return
+	var player: AudioStreamPlayer = AudioStreamPlayer.new()
+	player.bus = "Pecho"
+	player.stream = recording
+	player.finished.connect(player.queue_free)
+	add_child(player)
+	player.play()
+
+
 var performance_array: Array[OmniClipMemberInstance]
 var unperformance_array: Array[OmniClipMemberInstance]

